<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/splashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AIR GESTURES"
            android:textColor="@color/neon_cyan"
            android:textSize="34sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.12"
            android:shadowColor="@color/neon_cyan"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="18"
            android:alpha="0"
            android:scaleX="0.8"
            android:scaleY="0.8" />

        <View
            android:layout_width="64dp"
            android:layout_height="2dp"
            android:layout_marginTop="14dp"
            android:background="@color/neon_magenta"
            android:alpha="0.7" />

    </LinearLayout>

    <TextView
        android:id="@+id/splashCredit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="36dp"
        android:text="made with love by ADR"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.05"
        android:alpha="0" />

</FrameLayout>